# Copy to .env and fill in; `npm run start:env` loads it (Node --env-file, no dependency).
# Never commit .env.

# Public https origin Wix/BigCommerce can reach (tunnel URL for local testing).
# Used in profile endpoints, webhook destinations and OAuth redirect URIs.
PUBLIC_BASE_URL=https://example.trycloudflare.com

# --- Wix app (Developer Center -> your app -> OAuth) --------------------------
WIX_APP_ID=
WIX_APP_SECRET=
# Webhook public key (PEM). Multi-line values need quotes with literal \n escapes,
# or keep it on one line as shown.
WIX_APP_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# WIX_API_BASE=https://www.wixapis.com

# --- BigCommerce draft app (Developer Portal -> your app -> Technical) --------
BC_CLIENT_ID=
BC_CLIENT_SECRET=
# BC_LOGIN_BASE=https://login.bigcommerce.com
# BC_API_BASE=https://api.bigcommerce.com

# --- Service ------------------------------------------------------------------
# PORT=8787
# UCP_DATA_DIR=./data
# UCP_MASTER_KEY=<32-byte hex>   # else auto-generated at data/master.key
